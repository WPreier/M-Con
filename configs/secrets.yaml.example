# M-Con secrets. Copy to /etc/mcon/secrets.yaml (mode 0440, owner root:mcon).
# Replace every change-me value before starting the service.
# This file is an example only. Do not put production credentials in git.

admin:
  token: change-me-admin-token

clients:
  website:
    hmac_secret: change-me-hmac-secret
    webhook_secret: ""

providers:
  smtp-local:
    password: ""
  smtp-relay:
    password: ""
  sendgrid:
    api_key: change-me-sendgrid
  mailgun:
    api_key: change-me-mailgun
  ses:
    access_key: change-me-ses-access
    secret_key: change-me-ses-secret
  postmark:
    server_token: change-me-postmark
  brevo:
    api_key: change-me-brevo
  resend:
    api_key: change-me-resend
  graph:
    tenant_id: change-me-tenant
    client_id: change-me-graph-client
    client_secret: change-me-graph-secret
  gmail:
    client_id: change-me-gmail-client
    client_secret: change-me-gmail-secret
    refresh_token: change-me-gmail-refresh

spam:
  openrouter:
    api_key: change-me-openrouter
