# Local secrets for real-mail tests. Copy to configs/local/secrets.yaml (gitignored).
# Never commit real credentials.

admin:
  token: local-admin-token-change-me

clients:
  local:
    hmac_secret: local-hmac-secret-change-me
    webhook_secret: ""

providers:
  smtp-real:
    # SMTP AUTH password. Leave empty if username is empty (IP-trusted / no AUTH).
    # If mcon.yaml sets username, password is required (min length not enforced beyond non-empty).
    password: ""

spam:
  openrouter:
    api_key: ""
